 "regeln": [
  {
   "regel": "split_hersteller_typ",
   "wenn": "Spalte 'Hersteller, Typ' oder 'Hersteller/Typ'",
   "dann": "am ersten Komma bzw. Schrägstrich trennen: links Hersteller, rechts Typ"
  },
  {
   "regel": "split_standort_raum",
   "wenn": "Spalte 'Standort/Raum'",
   "dann": "enthält der Wert einen bekannten Standortnamen (SITE_LIST), ist dies der Standort und der Rest der Raum; sonst alles Raum, Standort aus Blattzuordnung"
  },
  {
   "regel": "datum",
   "wenn": "Anschaffung/Kaufdatum/Baujahr",
   "dann": "dd.mm.yyyy, yyyy-mm, mm/yyyy, yyyy akzeptieren; 'ca. 2019' -> 2019 mit Hinweis 'geschätzt'; leer -> Pflichtangabe fehlt (Gelb)"
  },
  {
   "regel": "freitext_pruefung",
   "wenn": "Letzte Prüfung als Text",
   "dann": "'STK 03/2025', 'MTK 2024-11', 'STK 14.09.2024' -> Prüfart + Monat/Datum; Fälligkeit = Datum + Intervall des Modells (E63)"
  },
  {
   "regel": "naechste_pruefung_hinweis",
   "wenn": "Spalte nächste STK/MTK/Prüfung",
   "dann": "nur als Hinweis speichern, nie als Fälligkeit (E63)"
  },
  {
   "regel": "kopfzeile",
   "wenn": "erste Zeile mit >= 3 Wörterbuch-Treffern",
   "dann": "ist die Kopfzeile; Zeilen davor werden als Titelzeilen übersprungen; Leerzeilen ignoriert"
  },
  {
   "regel": "blatt_standort",
   "wenn": "mehrere Blätter",
   "dann": "Blattname gegen SITE_LIST (Namensähnlichkeit) -> Standortvorschlag, sonst 'neuer Standort'"
  },
  {
   "regel": "normalisierung",
   "wenn": "Vergleich von Kopfzeilen, Herstellern, Typen",
   "dann": "kleinschreiben, Umlaute auflösen, Sonderzeichen/Leerzeichen/Bindestriche entfernen ('VOLUMAT X-200' == 'Volumat X200'), 'GmbH'/'Medical'/'Systems' am Ende ignorieren"
  }
 ]
