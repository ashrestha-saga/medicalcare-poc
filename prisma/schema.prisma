// DeviceCare data model — derived from Requirements Spec v8 + Erstanlage (MPBetreibV).
//
// PROVIDER NOTE
// Target database is MySQL. Fields marked `// JSON` hold serialized JSON as
// text for historical compatibility; you may optionally use `@db.Text` /
// `@db.LongText` or `Json` — the service layer already (de)serializes them.

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// C — Erstanlage / Pflichtenlogik enums (schema-erweiterung)
// ---------------------------------------------------------------------------

enum DutyCategory {
  inspection
  operating
}

enum DeadlineAnchor {
  exact_day
  month_end
  year_end
  event
  interval
  process
  permanent
  reference
  none
}

enum Confidence {
  verified
  responsible
  determination
  derived
  not_applicable
  /** @deprecated Prefer `derived`. Normalized to `derived` on read. */
  guess
}

/** Certainty of Anlage-2 term→device matching (narrower than Confidence). */
enum TermMatchConfidence {
  verified
  derived
}

enum IntervalUnit {
  months
  years
}

/**
 * Canonical duty keys persisted on DeviceDuty (dynamic ids like val-ref-* map here).
 * Fixture join vocabulary — keep in sync with fixtures/pflichten/vergleich_pflichten.py.
 */
enum DutyKey {
  wartung
  stk
  mtk
  abnahme
  konstanz
  sv
  aerztl
  nuklear
  itsec
  install
  aufbereitung
  kontrolle
  validierung
  validierung_verweis
  einmalprodukt
  zubehoer
  vernetzung
  implantat
  dguv
}

enum FieldState {
  open
  proposed
  confirmed
  chosen
  deferred
}

enum EvidenceKind {
  confirmation
  document
  third_party
}

// ---------------------------------------------------------------------------
// B — Wave 2 schema hygiene enums (SCH-03)
// ---------------------------------------------------------------------------

enum DeviceState {
  draft
  review
  released
  retired
}

enum ServiceRequestState {
  captured
  queued
  transmitted
  acknowledged
  scheduled
  in_progress
  completed
  rejected
}

enum OutboxState {
  pending
  processing
  delivered
  dead
}

enum ReminderStatus {
  pending
  sent
  failed
  skipped
}

enum PartnerAppRole {
  inspector
  admin
  order
}

enum RoleGrantKind {
  clinic
  partner_console
  partner_acting
}

enum TrainingMode {
  individual
  group
}

enum OperatingModel {
  provider_operated
  institution_operated
}

enum OrganisationCapacity {
  institution
  service_provider
  inspection_partner
  platform_operator
}

/** Where a partner staff member starts for dispatch (deployment area). */
enum DispatchOrigin {
  home
  /** Partner org depot / Betriebsstätte (free-text PLZ/city until OrganisationSite exists). */
  partner_site
  organisation
}

/** Prüfpartner catalogue scope — generic, annex2 item, constancy object, equipment type. */
enum CatalogueScope {
  generic
  annex2
  constancy
  equipment
}

/** Where a measurement limit comes from (Prüfpartner protocol). */
enum LimitSource {
  standard
  manufacturer
  applied_part
  annex2
  baseline
  operator
}


// ---------------------------------------------------------------------------
// K1–K10 enums
// ---------------------------------------------------------------------------

enum BookEntryKind {
  malfunction
  operating_error
  note
}

enum ReprocessingCheckScope {
  equipment
  water
  chemistry
  sterile_storage
}

enum CheckCadence {
  per_use
  daily
  weekly
  monthly
  quarterly
  yearly
  per_batch
}

enum BatchReleaseResult {
  released
  released_with_conditions
  rejected
}

enum TileZone {
  decides
  worklist
  watch
}

enum AuthorityKind {
  health_office
  device_authority
  occupational_safety
  metrology
  medical_board
  other
}

enum FindingStatus {
  open
  remediated
  proven
  disputed
  closed
}

/// Outbound authority / manufacturer notifications (replaces IncidentReport-only).
enum NotificationKind {
  /// Mutmaßlich schwerwiegendes Vorkommnis, § 3 MPAMIV.
  incident
  /// Abhilfenachweis zu einem Begehungsbefund.
  finding_remediation
  /// Anzeige oder Genehmigungsantrag nach Strahlenschutzrecht.
  radiation
  /// Unfallanzeige an den Unfallversicherungsträger.
  accident
  /// Mitteilung an die Eichbehörde.
  metrology
  other
}

enum NotificationChannel {
  authority_portal
  manufacturer_portal
  email
  post
  fax
  other
}

enum NotificationState {
  draft
  sent
  acknowledged
  closed
  withdrawn
}

enum NotificationDocumentRole {
  submission
  acknowledgement
  response
  attachment
}

/// Model-level document kinds (IFU lives on the Bauart, not the Exemplar).
enum DocumentKind {
  ifu
  service_manual
  safety_notice
  work_instruction
  other
}

enum DutyAddressee {
  operator
  employer
  both
}

enum ClinicRole {
  superadmin
  device_admin
  security_officer
  user
}

enum DutyPerformanceResult {
  passed
  passed_with_conditions
  failed
}

enum OrderApprovalState {
  pending_approval
  approved
  rejected
}

enum OrderRequestState {
  /** Create stamp only — spare-parts lifecycle is `OrderApprovalState`. */
  captured
}

// ---------------------------------------------------------------------------
// Tenancy and locations (FA-500..504, NFA-804)
// ---------------------------------------------------------------------------

model Tenant {
  id                  String                   @id @default(cuid())
  name                String
  /** Public tenant identifier (e.g. T-KLN). Unique when set. */
  code                String?                  @unique
  /** Who may suspend the contract (SCH-04/05). */
  operatingModel      OperatingModel           @default(institution_operated)
  /** Legal-entity Organisation with role=institution. Not used by the access gate. */
  institutionOrgId    String?
  institutionOrg      Organisation?            @relation("TenantInstitution", fields: [institutionOrgId], references: [id])
  createdAt           DateTime                 @default(now())
  users               User[]
  sites               Site[]
  areas               Area[]
  siteHeadcounts      SiteHeadcount[]
  safetyOfficerAppointments SafetyOfficerAppointment[]
  instances           DeviceInstance[]
  captured            CapturedArticle[]
  requests            ServiceRequest[]
  orderRequests       OrderRequest[]
  orderItems          OrderItem[]
  statusEvents        StatusEvent[]
  attachments         Attachment[]
  dispatchRecords     DispatchRecord[]
  dispatchTargets     DispatchTarget[]
  externalCalls       ExternalCallLog[]
  oxidConnection      TenantOxidConnection?
  maintenanceEvents   MaintenanceEvent[]
  releaseSnapshots    DeviceReleaseSnapshot[]
  deviceDuties        DeviceDuty[]
  deviceUnitEvents    DeviceUnitEvent[]
  dutyPerformances    DutyPerformance[]
  executorOrgs        ExecutorOrg[]
  serviceContracts    ServiceContract[]
  partnerStaffAssignments PartnerStaffAssignment[]
  trainingEvents      TrainingEvent[]
  trainingRecords     TrainingRecord[]
  auditEvents         AuditEvent[]
  attachmentBlobs     AttachmentBlob[]
  reprocessingProfiles DeviceReprocessingProfile[]
  dutyReminders       DutyReminder[]
  dispatchOutbox      DispatchOutbox[]
  deviceClarifications DeviceClarification[]
  deviceEvidence      DeviceEvidence[]
  reprocessingOnDevices ReprocessingOnDevice[]
  userInvitations     UserInvitation[]
  passwordResetTokens PasswordResetToken[]
  smtpSettings        SmtpSettings?
  inspectionRuns      InspectionRun[]
  baselineMeasurements BaselineMeasurement[]
  deviceBookEntries   DeviceBookEntry[]
  deviceIncidents     DeviceIncident[]
  fieldSafetyActions  FieldSafetyAction[]
  fieldSafetyDeviceActions FieldSafetyDeviceAction[]
  fieldSafetyAffectedModels FieldSafetyAffectedModel[]
  modelDocuments      ModelDocument[]
  reprocessingChecks  ReprocessingCheck[]
  reprocessingBatches ReprocessingBatch[]
  reprocessingBatchItems ReprocessingBatchItem[]
  constancyCadences   ConstancyCadence[]
  userDashboardTiles  UserDashboardTile[]
  authorityInspections AuthorityInspection[]
  authorityFindings   AuthorityFinding[]
  disclosureSessions  DisclosureSession[]
  dutyOverlapDecisions DutyOverlapDecision[]
  userAreaAssignments UserAreaAssignment[]
  authorityNotifications AuthorityNotification[]
  notificationDocuments NotificationDocument[]

  @@index([institutionOrgId])
}

/// Login identity. Clinic staff belong to one tenant. Partner staff belong to an organisation.
model User {
  id           String   @id @default(cuid())
  /** Set for clinic accounts. Null for partner accounts. */
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  email        String   @unique
  name         String
  /** Clinic role. Null for partner accounts (role lives on OrgMembership). */
  role         ClinicRole?
  /** clinic | partner — which login door accepts this account. */
  accountKind  String   @default("clinic")
  passwordHash String
  active       Boolean  @default(true)
  jobTitle     String?
  homeAreaId   String?
  homeArea     Area?    @relation("UserHomeArea", fields: [homeAreaId], references: [id])
  employedFrom DateTime? @db.Date
  employedTo   DateTime? @db.Date
  anonymisedAt DateTime?
  /** TOTP MFA — secret stored AES-GCM encrypted (base64 payload). */
  totpEnabled      Boolean   @default(false)
  totpSecretEnc    String?  @db.Text
  totpVerifiedAt   DateTime?
  /** JSON array of scrypt-hashed one-time backup codes. */
  totpBackupHashes String?  @db.Text
  /** Pending enrollment secret (encrypted) until confirm; cleared on enable/cancel. */
  totpPendingEnc   String?  @db.Text
  /** Cookies with iat before this instant are rejected (SEC-03). Null = no revocation yet. */
  sessionsValidFrom    DateTime?
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  serviceRequests      ServiceRequest[]       @relation("ServiceRequestRaisedBy")
  assignedRequests     ServiceRequest[]       @relation("ServiceRequestAssignee")
  orderRequests        OrderRequest[]
  oxidConnectionsMade  TenantOxidConnection[] @relation("OxidConnectedBy")
  totpChallenges       TotpChallenge[]
  responsibleDevices   DeviceInstance[]       @relation("DeviceResponsibleUser")
  createdInstances     DeviceInstance[]       @relation("DeviceCreatedBy")
  orgMemberships       OrgMembership[]
  trainingRecords      TrainingRecord[]
  permissions          UserPermission[]
  passwordResetTokens  PasswordResetToken[]
  qualifications       PersonQualification[]
  skills               PersonSkill[]
  inspectionRuns       InspectionRun[] @relation("InspectionPerformer")
  dashboardTiles       UserDashboardTile[]
  disclosureSessions   DisclosureSession[]
  areaAssignments      UserAreaAssignment[]
  releasedBatches      ReprocessingBatch[] @relation("BatchReleasedBy")
  performedChecks      ReprocessingCheck[] @relation("CheckPerformedBy")
  bookEntriesRecorded  DeviceBookEntry[] @relation("BookEntryRecorder")
  incidentsRecorded    DeviceIncident[] @relation("IncidentRecorder")
  incidentsAssessed    DeviceIncident[] @relation("IncidentAssessor")
  incidentsClosed      DeviceIncident[] @relation("IncidentCloser")
  incidentsAssigned    DeviceIncident[] @relation("IncidentAssignee")
  fieldSafetyRecorded  FieldSafetyAction[] @relation("FieldSafetyRecorder")
  fieldSafetyDeviceRecorded FieldSafetyDeviceAction[] @relation("FieldSafetyDeviceRecorder")
  batchesRecorded      ReprocessingBatch[] @relation("BatchRecorder")
  cadencesDetermined   ConstancyCadence[] @relation("CadenceDeterminer")
  inspectionsRecorded  AuthorityInspection[] @relation("InspectionRecorder")
  findingsRecorded     AuthorityFinding[] @relation("FindingRecorder")
  notificationsSent    AuthorityNotification[] @relation("NotificationSender")
  notificationsRecorded AuthorityNotification[] @relation("NotificationRecorder")
  dutyPerformances     DutyPerformance[] @relation("DutyPerformancePerformer")
  evidenceRecorded     DeviceEvidence[] @relation("DeviceEvidenceRecorder")
  modelDocumentsRecorded ModelDocument[] @relation("ModelDocumentRecorder")

  @@index([tenantId])
  @@index([accountKind])
  @@index([homeAreaId])
}

/** Work areas for clinic staff (Scan / inventory scope). homeAreaId remains the primary. */
model UserAreaAssignment {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  areaId    String
  area      Area      @relation(fields: [areaId], references: [id], onDelete: Cascade)
  validFrom DateTime  @db.Date
  validTo   DateTime? @db.Date
  createdAt DateTime  @default(now())

  @@unique([userId, areaId])
  @@index([tenantId, userId])
  @@index([areaId])
}

/** Per-user clinic permission snapshot. Empty set ⇒ fall back to RoleGrant for User.role. */
model UserPermission {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  createdAt  DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
}

/// Short-lived login challenge after password OK when TOTP is enabled.
model TotpChallenge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Exactly one OXID shop link per tenant — configured by admin in Settings.
model TenantOxidConnection {
  id                String    @id @default(cuid())
  tenantId          String    @unique
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  shopBaseUrl       String?
  customerNumber    String?
  companyName       String?
  /** AES-GCM encrypted OAuth access token (same format as TOTP secrets). */
  accessTokenEnc    String?   @db.Text
  /** AES-GCM encrypted OAuth refresh token. */
  refreshTokenEnc   String?   @db.Text
  expiresAt         DateTime?
  status            String    @default("disconnected") // disconnected | connected | error
  lastError         String?   @db.Text
  connectedAt       DateTime?
  connectedByUserId String?
  connectedBy       User?     @relation("OxidConnectedBy", fields: [connectedByUserId], references: [id])
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())
}

model Site {
  id                        String                     @id @default(cuid())
  tenantId                  String
  name                      String
  code                      String? // short site identifier (e.g. BONN-A)
  /** Denormalized display line (street, postal city). */
  address                   String?                    @db.Text
  street                    String?
  postalCode                String?
  city                      String?
  country                   String?                    @default("DE")
  /** ISO Bundesland code e.g. DE-NW — selects authority checklist; not derived from PLZ. */
  stateCode                 String?
  deliveryAddress           String?                    @db.Text
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id])
  areas                     Area[]
  headcounts                SiteHeadcount[]
  safetyOfficerAppointments SafetyOfficerAppointment[]
  reprocessingChecks        ReprocessingCheck[]
  authorityInspections      AuthorityInspection[]
  authorityNotifications    AuthorityNotification[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Area {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  siteId    String
  name      String
  site      Site             @relation(fields: [siteId], references: [id])
  instances DeviceInstance[]
  homeUsers User[]           @relation("UserHomeArea")
  userAssignments UserAreaAssignment[]

  @@index([siteId])
  @@index([tenantId])
}

model SiteHeadcount {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id])
  validFrom  DateTime @db.Date
  validTo    DateTime? @db.Date
  headcount  Int
  recordedBy String
  recordedAt DateTime @default(now())

  @@index([siteId])
  @@index([tenantId])
}

model SafetyOfficerAppointment {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  siteId           String
  site             Site      @relation(fields: [siteId], references: [id])
  personName       String
  functionalEmail  String?
  appointedFrom    DateTime  @db.Date
  appointedTo      DateTime? @db.Date
  publishedAt      DateTime? @db.Date
  documentRef      String?

  @@index([siteId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Device master (model) vs. device inventory (instance) — never merged
// ---------------------------------------------------------------------------

model DeviceModel {
  id                     String                     @id @default(cuid())
  basicUdiDi             String?                    @unique
  udiDi                  String?
  gtins                  String?                    @db.Text // JSON string[]
  manufacturer           String?
  manufacturerSrn        String?
  tradeName              String?
  modelName              String?
  riskClass              String?
  emdnCode               String?
  gmdnCode               String?
  productSeries          String?
  source                 String // manual | catalog | beudamed | wizard
  sourceFetchedAt        DateTime?
  version                Int                        @default(1)
  state                  DeviceState                @default(draft)
  maintenanceCycleMonths Int?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  instances              DeviceInstance[]
  externalRecords        ExternalSourceRecord[]
  classifications        DeviceModelClassification[]
  trainingEvents         TrainingEvent[]
  incidents              DeviceIncident[]
  fieldSafetyAffectedModels FieldSafetyAffectedModel[]
  documents              ModelDocument[]

  @@index([udiDi])
  @@index([manufacturer, modelName])
}

/// Document on the MODEL (Bauart), not the Exemplar. Current = latest validFrom without supersededAt.
model ModelDocument {
  id                  String         @id @default(cuid())
  tenantId            String
  tenant              Tenant         @relation(fields: [tenantId], references: [id])
  deviceModelId       String
  deviceModel         DeviceModel    @relation(fields: [deviceModelId], references: [id])
  kind                DocumentKind
  revisionLabel       String
  language            String         @default("de")
  validFrom           DateTime       @db.Date
  supersededAt        DateTime?      @db.Date
  supersededById      String?
  supersededBy        ModelDocument? @relation("DocChain", fields: [supersededById], references: [id])
  successors          ModelDocument[] @relation("DocChain")
  fieldSafetyActionId String?
  fieldSafetyAction   FieldSafetyAction? @relation(fields: [fieldSafetyActionId], references: [id])
  blobId              String?
  blob                AttachmentBlob? @relation(fields: [blobId], references: [id])
  externalUrl         String?
  recordedByName      String
  recordedByUserId    String?
  recordedByUser      User?          @relation("ModelDocumentRecorder", fields: [recordedByUserId], references: [id])
  recordedAt          DateTime       @default(now())

  @@unique([deviceModelId, kind, revisionLabel, language])
  @@index([deviceModelId, kind, supersededAt])
  @@index([tenantId])
  @@index([blobId])
  @@index([fieldSafetyActionId])
  @@index([recordedByUserId])
}

model ExternalSourceRecord {
  id            String      @id @default(cuid())
  deviceModelId String
  deviceModel   DeviceModel @relation(fields: [deviceModelId], references: [id])
  source        String // "beudamed" | "oxid"
  identifier    String
  payload       String      @db.LongText
  fetchedAt     DateTime

  @@index([source, identifier, fetchedAt])
  @@index([deviceModelId])
}

model DeviceInstance {
  id                     String                   @id @default(cuid())
  tenantId               String
  tenant                 Tenant                   @relation(fields: [tenantId], references: [id])
  inventoryNumber        String
  serialNumber           String?
  udiDi                  String?
  modelId                String?
  model                  DeviceModel?             @relation(fields: [modelId], references: [id])
  areaId                 String?
  area                   Area?                    @relation(fields: [areaId], references: [id])
  room                   String?
  commissionedAt         DateTime?
  responsiblePerson      String?
  responsibleUserId      String?
  responsibleUser        User?                    @relation("DeviceResponsibleUser", fields: [responsibleUserId], references: [id])
  /** draft | review | released | retired */
  state                  DeviceState              @default(draft)
  /** ERF-04 — 1 self / 2 document / 3 third-party; derived from Merkmale on release. */
  releaseLevel           Int?
  productKindCode        String?
  source                 String                   @default("wizard") // wizard | manual | import | scan | external
  legacyMedgvGroup1      Boolean                  @default(false)
  aedExemption           Boolean                  @default(false)
  /** Wizard Merkmale blob before/after freeze (JSON). */
  characteristicsJson    String?                  @db.LongText
  parentInstanceId       String?
  parentInstance         DeviceInstance?          @relation("DeviceAccessory", fields: [parentInstanceId], references: [id])
  childInstances         DeviceInstance[]         @relation("DeviceAccessory")
  retiredAt              DateTime?
  /// Legal decommission date (§ 13 retention clock). Distinct from retiredAt (workflow).
  decommissionedAt       DateTime?                @db.Date
  /// Book/evidence may be purged only after this date (set when decommissioned).
  retainUntil            DateTime?                @db.Date
  mergedIntoId           String?
  createdByUserId        String?
  createdByUser          User?                    @relation("DeviceCreatedBy", fields: [createdByUserId], references: [id])
  maintenanceCycleMonths Int?
  maintenanceAnchorAt    DateTime?
  lastMaintainedAt       DateTime?
  nextMaintenanceDueAt   DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  maintenanceEvents      MaintenanceEvent[]
  releaseSnapshots       DeviceReleaseSnapshot[]
  duties                 DeviceDuty[]
  referencingDuties      DeviceDuty[]             @relation("DutyReference")
  unitEvents             DeviceUnitEvent[]
  reprocessingProfile    DeviceReprocessingProfile?
  clarifications         DeviceClarification[]
  evidence               DeviceEvidence[]
  reprocessedOn          ReprocessingOnDevice[]   @relation("ReprocessedItem")
  usedForReprocessing    ReprocessingOnDevice[]   @relation("ReprocessingEquipment")
  inspectionRuns         InspectionRun[]
  baselineMeasurements   BaselineMeasurement[]
  bookEntries            DeviceBookEntry[]
  incidents              DeviceIncident[]
  fieldSafetyDeviceActions FieldSafetyDeviceAction[]
  reprocessingChecksAsEquipment ReprocessingCheck[] @relation("ReprocessingCheckEquipment")
  reprocessingBatchesAsEquipment ReprocessingBatch[] @relation("ReprocessingBatchEquipment")
  reprocessingBatchItems ReprocessingBatchItem[] @relation("ReprocessingBatchItemDevice")
  constancyCadences      ConstancyCadence[]
  dutyOverlapDecisions   DutyOverlapDecision[]
  authorityFindings      AuthorityFinding[]
  authorityNotifications AuthorityNotification[] @relation("NotificationDevice")

  @@unique([tenantId, inventoryNumber])
  /** SCH-01 — same serial under the same model is rejected (NULLs allowed). */
  @@unique([tenantId, modelId, serialNumber])
  @@index([tenantId, serialNumber])
  @@index([tenantId, nextMaintenanceDueAt])
  @@index([tenantId, state])
  @@index([responsibleUserId])
  @@index([tenantId, retainUntil])
}

model MaintenanceEvent {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  deviceInstanceId String
  deviceInstance   DeviceInstance @relation(fields: [deviceInstanceId], references: [id])
  kind             String
  performedAt      DateTime
  previousDueAt    DateTime?
  nextDueAt        DateTime?
  cycleMonths      Int?
  note             String?        @db.Text
  actorUserId      String?
  createdAt        DateTime       @default(now())

  @@index([tenantId, deviceInstanceId, performedAt])
  @@index([tenantId, performedAt])
}

model CapturedArticle {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  name                  String
  manufacturer          String?
  number                String?
  numberType            String // gtin | pzn | manufacturer | none
  rawIdentifier         String?
  nameplateAttachmentId String?
  capturedBy            String?
  capturedAt            DateTime @default(now())
  serviceOnly           Boolean  @default(true)

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Regulatory reference data (cross-tenant, seeded)
// ---------------------------------------------------------------------------

model RefRuleSet {
  id              String                        @id
  code            String
  title           String
  legalBasis      String
  versionLabel    String
  validFrom       DateTime                      @db.Date
  validTo         DateTime?                     @db.Date
  sourceNote      String?                       @db.Text
  inspectionTypes RefInspectionType[]
  annex2Items     RefAnnex2Item[]
  reprocClasses   RefReprocessingClass[]
  reprocEquipment RefReprocessingEquipmentType[]
  radiationApps   RefRadiationApplication[]
  constancyObjects RefConstancyObject[]
  trainingTypes   RefTrainingType[]
  classifications DeviceModelClassification[]
  commissioningPrerequisites RefCommissioningPrerequisite[]
  inspectionCatalogues       RefInspectionCatalogue[]
  qualifications             RefQualification[]
  reprocessingChecks         RefReprocessingCheck[]

  @@unique([code, versionLabel])
}

model RefInspectionType {
  code             String         @id
  ruleSetId        String
  ruleSet          RefRuleSet     @relation(fields: [ruleSetId], references: [id])
  label            String
  legalBasis       String
  deadlineAnchor   DeadlineAnchor
  defaultInterval  Int?
  intervalUnit     IntervalUnit?
  evidenceHint     String?        @db.Text
  category         DutyCategory   @default(inspection)
  confidence       Confidence     @default(derived)
  sourceRef        String?
  addressee        DutyAddressee  @default(operator)
  authorityKind    AuthorityKind?
  duties           DeviceDuty[]
  catalogues       RefInspectionCatalogue[]
  qualificationRules RefQualificationRule[]
  overlapsCovered  RefInspectionTypeOverlap[] @relation("OverlapCovered")
  overlapsCovering RefInspectionTypeOverlap[] @relation("OverlapCovering")
}

model RefAnnex2Item {
  id               String     @id
  ruleSetId        String
  ruleSet          RefRuleSet @relation(fields: [ruleSetId], references: [id])
  itemNo           String
  parentItemNo     String?
  label            String     @db.Text
  restriction      String?    @db.Text
  isGroup          Boolean    @default(false)
  intervalYears    Int?
  conditionText    String?    @db.Text
  matchTerms       Json
  matchExclude     Json
  /** Certainty of the term→device matching (distinct from interval `confidence`). */
  termMatchConfidence TermMatchConfidence @default(derived)
  reviewFlag       String?
  confidence       Confidence @default(derived)
  sourceRef        String?
  classifications  DeviceModelClassification[]

  @@index([ruleSetId, itemNo])
}

model RefProductKind {
  code      String @id
  label     String
  hint      String?
  sortGroup String
  shows     Json   // string[]
  blocks    Json   // string[]
  presets   Json   // object
}

model RefReprocessingClass {
  code                     String  @id
  ruleSetId                String
  ruleSet                  RefRuleSet @relation(fields: [ruleSetId], references: [id])
  label                    String
  requiresQmsCert          Boolean @default(false)
  /** AUF-01 — false for unkritisch (intact skin only). */
  requiresValidatedProcess Boolean @default(true)
  evidence                 String? @db.Text
  note                     String? @db.Text
  profiles                 DeviceReprocessingProfile[]
}

model RefReprocessingEquipmentType {
  code                String @id
  ruleSetId           String
  ruleSet             RefRuleSet @relation(fields: [ruleSetId], references: [id])
  label               String
  equipmentStandard   String
  validationStandard  String
  revalidationMonths  Int
  intervalDisputed    Boolean @default(false)
  intervalSource      String  @db.Text
  routineChecks       String  @db.Text // JSON string[] — superseded by RefReprocessingCheck; kept for cutover
  releaseRule         String? @db.Text
  checks              RefReprocessingCheck[]
}

model RefRadiationApplication {
  code                   String  @id
  ruleSetId              String
  ruleSet                RefRuleSet @relation(fields: [ruleSetId], references: [id])
  label                  String
  defaultAuthorisation   String // notification | licence
  medicalBoardNote       String? @db.Text
  qualityGuideline       String?
  expertInspectionApplies Boolean @default(true)
}

model RefConstancyObject {
  code            String @id
  ruleSetId       String
  ruleSet         RefRuleSet @relation(fields: [ruleSetId], references: [id])
  label           String
  defaultCadence  String
  duties          DeviceDuty[]
  cadences        ConstancyCadence[]
}

model RefTrainingType {
  code            String @id
  ruleSetId       String
  ruleSet         RefRuleSet @relation(fields: [ruleSetId], references: [id])
  label           String
  legalBasis      String
  subjectKind     String // model | activity
  validityMonths  Int?
  chainAllowed    Boolean @default(false)
  note            String? @db.Text
  trainingEvents  TrainingEvent[]
}

/** C2 — versioned commissioning checklist (was hard-coded in prerequisites.ts). */
model RefCommissioningPrerequisite {
  id           String       @id @default(cuid())
  ruleSetId    String
  ruleSet      RefRuleSet   @relation(fields: [ruleSetId], references: [id])
  code         String
  label        String
  legalBasis   String
  note         String?      @db.Text
  mandatory    Boolean      @default(true)
  evidenceKind EvidenceKind @default(confirmation)
  /** Expression over Merkmale (JSON-ish / simple keys); evaluated in app. */
  appliesWhen  String       @db.Text
  releaseLevel Int          @default(1)

  @@unique([ruleSetId, code])
  @@index([ruleSetId])
}

// ---------------------------------------------------------------------------
// Model classification (historised) + release freeze
// ---------------------------------------------------------------------------

model DeviceModelClassification {
  id             String       @id @default(cuid())
  deviceModelId  String
  deviceModel    DeviceModel  @relation(fields: [deviceModelId], references: [id])
  validFrom      DateTime     @default(now())
  validTo        DateTime?
  stk            Boolean      @default(false)
  mtkItemId      String?
  mtkItem        RefAnnex2Item? @relation(fields: [mtkItemId], references: [id])
  radiation      Boolean      @default(false)
  softwareClass  String?
  confidence     Confidence   @default(derived)
  evidenceText   String?      @db.Text
  ruleSetId      String
  ruleSet        RefRuleSet   @relation(fields: [ruleSetId], references: [id])
  confirmedBy    String?
  confirmedAt    DateTime?
  /** C4 — product kind + model-owned Merkmale for reuse across instances. */
  productKindCode String?
  characteristics String?     @db.LongText // JSON
  fieldStates     String?     @db.LongText // JSON: field → FieldState
  decisions       String?     @db.LongText // JSON: field → { value, proposal, by, at }
  deferredFields  String?     @db.Text // JSON string[]
  /**
   * SCH-02 — set to deviceModelId while validTo is null; cleared when closed.
   * Unique so only one open classification per model.
   */
  openClassificationKey String? @unique @db.VarChar(191)
  /** STK patient leakage limit follows applied-part type (B/BF/CF). */
  appliedPartCode   String?
  appliedPart       RefAppliedPartType? @relation(fields: [appliedPartCode], references: [code])
  /** STK functional test block. */
  deviceFamilyCode  String?
  deviceFamily      RefDeviceFamily? @relation(fields: [deviceFamilyCode], references: [code])
  snapshots      DeviceReleaseSnapshot[]

  @@index([deviceModelId])
  @@index([deviceModelId, validTo])
  @@index([appliedPartCode])
  @@index([deviceFamilyCode])
}

model DeviceReleaseSnapshot {
  id               String                    @id @default(cuid())
  tenantId         String
  tenant           Tenant                    @relation(fields: [tenantId], references: [id])
  deviceInstanceId String
  deviceInstance   DeviceInstance            @relation(fields: [deviceInstanceId], references: [id])
  releasedAt       DateTime                  @default(now())
  releasedBy       String
  ruleSetIds       String                    @db.Text // JSON string[]
  classificationId String?
  classification   DeviceModelClassification? @relation(fields: [classificationId], references: [id])
  characteristics  String                    @db.LongText // JSON
  derivedDuties    String                    @db.LongText // JSON
  prerequisites    String                    @db.LongText // JSON
  appVersion       String
  duties           DeviceDuty[]

  @@index([deviceInstanceId, releasedAt])
  @@index([tenantId])
}

model DeviceDuty {
  id                  String                 @id @default(cuid())
  tenantId            String
  tenant              Tenant                 @relation(fields: [tenantId], references: [id])
  deviceInstanceId    String
  deviceInstance      DeviceInstance         @relation(fields: [deviceInstanceId], references: [id])
  snapshotId          String
  snapshot            DeviceReleaseSnapshot  @relation(fields: [snapshotId], references: [id])
  dutyKey             DutyKey
  inspectionTypeCode  String
  inspectionType      RefInspectionType      @relation(fields: [inspectionTypeCode], references: [code])
  deadlineAnchor      DeadlineAnchor
  intervalValue       Int?
  intervalUnit        IntervalUnit?
  cadenceLabel        String?
  constancyObjectCode String?
  constancyObject     RefConstancyObject?    @relation(fields: [constancyObjectCode], references: [code])
  basisText           String                 @db.Text
  confidence          Confidence
  applicable          Boolean                @default(true)
  notApplicableReason String?                @db.Text
  referenceDate       DateTime               @db.Date
  /** Computed from referenceDate + interval + deadlineAnchor; null for event/process/permanent. */
  dueAt               DateTime?              @db.Date
  lastCompletedAt     DateTime?
  lastNotifiedAt      DateTime?
  /** Reminder stage last sent (T-90 | T-30 | T-7 | due | overdue). */
  notifyStage         String?
  suspendedAt         DateTime?
  title               String?
  evidenceHint        String?                @db.Text
  category            DutyCategory           @default(inspection)
  setsBaseline        Boolean                @default(false)
  requiresBaseline    Boolean                @default(false)
  /** AUF-01 — product duty that references equipment instance. */
  referenceDeviceId   String?
  referenceDevice     DeviceInstance?        @relation("DutyReference", fields: [referenceDeviceId], references: [id])
  serviceRequests     ServiceRequest[]
  performances        DutyPerformance[]
  reminders           DutyReminder[]
  inspectionRuns      InspectionRun[]

  @@index([deviceInstanceId])
  @@index([tenantId])
  @@index([snapshotId])
  /** Hot path: dashboard counts + due-dates board (`applicable` + active + dueAt). */
  @@index([tenantId, applicable, suspendedAt, dueAt])
  /** Tile filters that scope by dutyKey (konstanz, validierung, …). */
  @@index([tenantId, dutyKey, applicable, suspendedAt])
  @@index([referenceDeviceId])
}

/** FA-715 — completion history that rolls the next due date. */
model DutyPerformance {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  deviceDutyId     String
  deviceDuty       DeviceDuty     @relation(fields: [deviceDutyId], references: [id])
  serviceRequestId String?
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  performedAt      DateTime       @db.Date
  result           DutyPerformanceResult @default(passed)
  note             String?        @db.Text
  /** Frozen display name (survives rename). */
  performedBy      String
  /** Account that performed the duty when known; null for import/external actor strings. */
  performedByUserId String?
  performedByUser  User?          @relation("DutyPerformancePerformer", fields: [performedByUserId], references: [id])
  source           String         @default("assignment") // assignment | manual | import
  recordedAt       DateTime       @default(now())
  inspectionRun    InspectionRun?

  @@index([deviceDutyId, performedAt])
  @@index([tenantId])
  @@index([serviceRequestId])
  @@index([performedByUserId])
}

/// Legal entity once. Capacity lives on OrganisationRole — not inferred from the table.
model Organisation {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  contact     String?
  /** MySQL DATE cannot default to CURRENT_TIMESTAMP — set in app/seed. */
  activeFrom  DateTime @db.Date
  activeTo    DateTime? @db.Date
  memberships OrgMembership[]
  employedExternals OrgMembership[] @relation("ExternalEmployerOrg")
  contracts   ServiceContract[]
  roles       OrganisationRole[]
  invitations UserInvitation[]
  institutionTenants Tenant[] @relation("TenantInstitution")
  smtpSettings SmtpSettings?
  executorOrgs ExecutorOrg[]
  organisationSites OrganisationSite[]
  testEquipment     TestEquipment[]
  inspectionRuns    InspectionRun[]

  @@index([activeTo])
}

/** Outbound SMTP for a clinic tenant or partner organisation (exactly one owner). */
model SmtpSettings {
  id              String        @id @default(cuid())
  tenantId        String?       @unique
  tenant          Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organisationId  String?       @unique
  organisation    Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  host            String
  port            Int           @default(587)
  secure          Boolean       @default(false)
  user            String
  passEnc         String        @db.Text
  fromAddr        String
  updatedAt       DateTime      @updatedAt
  updatedByUserId String?

  @@index([organisationId])
}

/// Capacity of an organisation: institution | service_provider | inspection_partner | platform_operator.
model OrganisationRole {
  id             String               @id @default(cuid())
  organisationId String
  organisation   Organisation         @relation(fields: [organisationId], references: [id])
  role           OrganisationCapacity
  grantedFrom    DateTime             @db.Date
  grantedTo      DateTime?            @db.Date

  @@unique([organisationId, role])
  @@index([role, grantedTo])
}

/// A partner user at one organisation. Clinic users do not get a row here.
model OrgMembership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  /** inspector | admin | order */
  appRole        PartnerAppRole
  /** MySQL DATE cannot default to CURRENT_TIMESTAMP — set in app/seed. */
  validFrom      DateTime     @db.Date
  validTo        DateTime?    @db.Date
  /** External inspector commissioned by this organisation (Fremdprüfer). */
  isExternal       Boolean   @default(false)
  commissionedFrom DateTime? @db.Date
  commissionedTo   DateTime? @db.Date
  liabilityUntil   DateTime? @db.Date
  liabilitySumEur  Int?
  /** Deployment / dispatch starting point. */
  dispatchOrigin   DispatchOrigin @default(organisation)
  originPostalCode String?
  originCity       String?
  radiusKm         Int?
  /** Employer org when isExternal (e.g. Radiotec); commissioning org is organisationId. */
  employerOrganisationId String?
  employerOrganisation   Organisation? @relation("ExternalEmployerOrg", fields: [employerOrganisationId], references: [id])
  organisationSiteId     String?
  organisationSite       OrganisationSite? @relation(fields: [organisationSiteId], references: [id])
  staffAssignments PartnerStaffAssignment[]

  @@unique([organisationId, userId])
  @@index([userId])
  @@index([organisationId, isExternal])
  @@index([employerOrganisationId])
}

/// Formal qualification catalogue (Fachkunde etc.).
model RefQualification {
  code       String  @id
  ruleSetId  String  @default("rs-mpbetreibv")
  ruleSet    RefRuleSet @relation(fields: [ruleSetId], references: [id])
  label      String  @db.Text
  legalBasis String?
  rules      RefQualificationRule[]
  catalogues RefCatalogueQualification[]
  persons    PersonQualification[]
}

/// Device-specific familiarity catalogue.
model RefSkill {
  code    String @id
  label   String
  persons PersonSkill[]
}

/// Ranked skill levels: eingewiesen < geuebt < hersteller.
model RefSkillLevel {
  code    String @id
  label   String
  rank    Int    @unique
  persons PersonSkill[]
}

/// Formal qualification held by a user (clinic or partner).
model PersonQualification {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  qualificationCode String
  qualification     RefQualification @relation(fields: [qualificationCode], references: [code])
  validUntil        DateTime?        @db.Date
  evidenceRef       String?
  recordedBy        String
  recordedAt        DateTime         @default(now())

  @@unique([userId, qualificationCode])
  @@index([validUntil])
}

/// Device skill held by a user.
model PersonSkill {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillCode   String
  skill       RefSkill      @relation(fields: [skillCode], references: [code])
  levelCode   String
  level       RefSkillLevel @relation(fields: [levelCode], references: [code])
  validUntil  DateTime?     @db.Date
  evidenceRef String?
  recordedBy  String
  recordedAt  DateTime      @default(now())

  @@unique([userId, skillCode])
  @@index([validUntil])
}

/// Which managed tenants a partner membership may act on (non-admin fail-closed).
model PartnerStaffAssignment {
  id           String        @id @default(cuid())
  membershipId String
  membership   OrgMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  @@unique([membershipId, tenantId])
  @@index([tenantId])
}

/// Live link that lets a service_provider organisation open one clinic.
model ServiceContract {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  validFrom      DateTime     @db.Date
  validTo        DateTime?    @db.Date
  terminatedAt   DateTime?
  suspendedAt    DateTime?
  billingRef     String?
  /** Art. 28 AVV Nachweis reference (provider_operated). */
  avvRef         String?
  /**
   * Legacy JSON string[] tokens — inventory | due-dates | inspection | reprocessing | training.
   * Dual-read with ServiceContractScopeGrant (Phase 8); grants win when present.
   */
  scope          String       @db.Text
  scopeGrants    ServiceContractScopeGrant[]

  @@unique([tenantId, organisationId])
  @@index([organisationId])
}

/// Fine-grained contract scope (permission slug). denied=true means “nie” for that slug.
model ServiceContractScopeGrant {
  id           String          @id @default(cuid())
  contractId   String
  contract     ServiceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  /** PermissionSlug (e.g. inventory:view) or legacy token kept for display only when source=token. */
  permission   String
  /** When true, this slug must never be granted even if role base includes it. */
  denied       Boolean         @default(false)
  /** token = expanded from ServiceContract.scope; manual = operator override / nie. */
  source       String          @default("token")
  createdAt    DateTime        @default(now())

  @@unique([contractId, permission])
  @@index([contractId, denied])
}

/// Schulungstermin — one event, many individual training_record proofs.
model TrainingEvent {
  id                       String   @id @default(cuid())
  tenantId                 String
  tenant                   Tenant   @relation(fields: [tenantId], references: [id])
  trainingTypeCode         String
  trainingType             RefTrainingType @relation(fields: [trainingTypeCode], references: [code])
  /** Exactly one of subjectModelId | subjectActivity (enforced in app). */
  subjectModelId           String?
  subjectModel             DeviceModel? @relation(fields: [subjectModelId], references: [id])
  subjectActivity          String?
  heldOn                   DateTime @db.Date
  location                 String?
  instructorName           String
  instructorQualification  String
  instructorExternal       Boolean  @default(false)
  basisDocument            String
  /** individual | group */
  mode                     TrainingMode
  recordedBy               String
  recordedAt               DateTime @default(now())
  records                  TrainingRecord[]

  @@index([tenantId, heldOn])
  @@index([trainingTypeCode])
  @@index([subjectModelId])
}

/// Einzelnachweis je clinic staff User (ops.person mapped onto User).
model TrainingRecord {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  eventId     String
  event       TrainingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /** Clinic staff subject — accountKind=clinic, tenant-scoped. Never a partner User. */
  personId    String
  person      User          @relation(fields: [personId], references: [id])
  confirmedAt DateTime      @default(now())
  validUntil  DateTime?     @db.Date

  @@unique([eventId, personId])
  @@index([tenantId])
  @@index([personId, validUntil])
}

/** FA-713 — in-house executor still stored per clinic. External partners use Organisation. */
model ExecutorOrg {
  id             String        @id @default(cuid())
  tenantId       String
  tenant         Tenant        @relation(fields: [tenantId], references: [id])
  code           String // O-MSR | O-RTS | O-INT
  name           String
  kind           String // external | internal
  active         Boolean       @default(true)
  sortOrder      Int           @default(0)
  /** When set, links this clinic executor row to the partner Organisation. */
  organisationId String?
  organisation   Organisation? @relation(fields: [organisationId], references: [id])
  requests       ServiceRequest[]
  dispatchTargets DispatchTarget[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([organisationId])
}

model DeviceUnitEvent {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  deviceInstanceId String
  deviceInstance   DeviceInstance @relation(fields: [deviceInstanceId], references: [id])
  occurredAt       DateTime       @default(now())
  actor            String
  action           String
  fromState        String?
  toState          String?
  note             String?        @db.Text

  @@index([deviceInstanceId, occurredAt])
  @@index([tenantId])
}

model DeviceReprocessingProfile {
  deviceInstanceId String                 @id
  deviceInstance   DeviceInstance         @relation(fields: [deviceInstanceId], references: [id])
  tenantId         String
  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  classCode        String
  reprocessingClass RefReprocessingClass  @relation(fields: [classCode], references: [code])
  outsourced       Boolean                @default(false)
  contractor       String?
  assessedBy       String
  assessedAt       DateTime               @default(now())

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Service requests (FA-600..602, SS-701..703)
// ---------------------------------------------------------------------------

model ServiceRequest {
  id              String              @id @default(cuid())
  reference       String              @unique
  idempotencyKey  String              @unique
  fingerprint     String
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  subjectType     String // instance | model | captured
  subjectId       String
  serviceType     String
  priority        String?
  note            String?             @db.Text
  raisedBy        String?
  raisedById      String?
  raisedByUser    User?               @relation("ServiceRequestRaisedBy", fields: [raisedById], references: [id])
  siteId          String?
  locationText    String              @db.Text
  accessHint      String?             @db.Text
  contact         String?
  deliveryAddress String              @db.Text
  /** Optional legacy JSON; no longer driven by a proposal engine. */
  classification  String?             @db.Text
  correlationId   String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  state           ServiceRequestState @default(captured)
  /** FA-710 — due_date | app */
  source          String              @default("app")
  /** When created from a Fälligkeit (FA-702). */
  dutyId          String?
  duty            DeviceDuty?         @relation(fields: [dutyId], references: [id])
  /** FA-713 — allocated executor organisation. */
  executorOrgId   String?
  executorOrg     ExecutorOrg?        @relation(fields: [executorOrgId], references: [id])
  allocatedAt     DateTime?
  allocatedBy     String?
  /** FA-714 — set on transmit; allocation becomes immutable. */
  transmittedAt   DateTime?
  /** Partner user assigned to perform the work (Disposition). */
  assigneeUserId  String?
  assigneeUser    User?               @relation("ServiceRequestAssignee", fields: [assigneeUserId], references: [id])
  /** Appointment date/time — moves state to scheduled when set. */
  scheduledAt     DateTime?
  statusEvents    StatusEvent[]
  attachments     Attachment[]
  dispatchRecords DispatchRecord[]
  performances    DutyPerformance[]
  dispatchOutbox  DispatchOutbox[]
  inspectionRuns  InspectionRun[]

  @@index([tenantId, createdAt])
  @@index([raisedById])
  @@index([dutyId])
  @@index([executorOrgId])
  @@index([tenantId, assigneeUserId])
  @@index([tenantId, source, state])
}

model StatusEvent {
  id               String              @id @default(cuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  serviceRequestId String
  serviceRequest   ServiceRequest      @relation(fields: [serviceRequestId], references: [id])
  state            ServiceRequestState
  changedAt        DateTime            @default(now())
  source           String
  actor            String?
  note             String?             @db.Text

  @@index([serviceRequestId, changedAt])
  @@index([tenantId])
}

model Attachment {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  kind             String
  url              String         @db.Text
  createdAt        DateTime       @default(now())

  @@index([serviceRequestId])
  @@index([tenantId])
}

model AttachmentBlob {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  kind        String
  /// Legacy inline payload; new large uploads prefer storageKey (dual-read).
  dataUrl     String?  @db.LongText
  /// Object-storage / filesystem key (Phase 6). Mutually preferred over dataUrl for new writes.
  storageKey  String?  @db.VarChar(512)
  contentType String?
  byteSize    Int?
  /// SHA-256 of file bytes (hex). Client computes; server re-hashes on receive.
  sha256      String?  @db.VarChar(64)
  createdAt   DateTime @default(now())
  evidence    DeviceEvidence[]
  authorityFindings AuthorityFinding[]
  processRecordOf   ReprocessingBatch[] @relation("BatchProcessRecord")
  bookEntries       DeviceBookEntry[]
  notificationDocuments NotificationDocument[]
  modelDocuments    ModelDocument[]

  @@index([tenantId])
  @@index([tenantId, sha256])
  @@index([storageKey])
}

model DispatchTarget {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  /** Owning executor — each org has its own mail / API endpoints. */
  executorOrgId String?
  executorOrg   ExecutorOrg? @relation(fields: [executorOrgId], references: [id])
  type          String
  name          String
  endpoint      String?      @db.Text
  auth          String?      @db.Text
  mapping       String?      @db.Text
  enabled       Boolean      @default(true)
  retryPolicy   String?      @db.Text

  dispatchRecords DispatchRecord[]
  outboxEntries   DispatchOutbox[]

  @@index([tenantId, enabled])
  @@index([executorOrgId, enabled])
}

model DispatchRecord {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  serviceRequestId String
  serviceRequest   ServiceRequest  @relation(fields: [serviceRequestId], references: [id])
  targetId         String?
  targetRef        DispatchTarget? @relation(fields: [targetId], references: [id])
  target           String
  timestamp        DateTime        @default(now())
  success          Boolean         @default(false)
  httpStatus       Int?
  response         String?         @db.Text
  error            String?         @db.Text
  attemptCount     Int             @default(1)
  correlationId    String?

  @@index([serviceRequestId])
  @@index([tenantId])
}

model OrderRequest {
  id              String      @id @default(cuid())
  reference       String      @unique
  idempotencyKey  String      @unique
  fingerprint     String
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  raisedBy        String?
  raisedById      String?
  raisedByUser    User?       @relation(fields: [raisedById], references: [id])
  subjectType     String?
  subjectId       String?
  deliveryAddress String      @db.Text
  note            String?     @db.Text
  approvalState   OrderApprovalState @default(pending_approval)
  state           OrderRequestState  @default(captured)
  correlationId   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([tenantId, createdAt])
  @@index([raisedById])
}

model OrderItem {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
