// DeviceCare data model — derived from Requirements Spec v8 + Erstanlage (MPBetreibV).
//
// PROVIDER NOTE
// Target database is MySQL. Fields marked `// JSON` hold serialized JSON as
// text for historical compatibility; you may optionally use `@db.Text` /
// `@db.LongText` or `Json` — the service layer already (de)serializes them.

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// C — Erstanlage / Pflichtenlogik enums (schema-erweiterung)
// ---------------------------------------------------------------------------

enum DutyCategory {
  inspection
  operating
}

enum DeadlineAnchor {
  exact_day
  month_end
  year_end
  event
  interval
  process
  permanent
  reference
  none
}

enum Confidence {
  verified
  responsible
  determination
  derived
  not_applicable
  guess
}

enum FieldState {
  open
  proposed
  confirmed
  chosen
  deferred
}

enum EvidenceKind {
  confirmation
  document
  third_party
}

// ---------------------------------------------------------------------------
// B — Wave 2 schema hygiene enums (SCH-03)
// ---------------------------------------------------------------------------

enum DeviceState {
  draft
  review
  released
  retired
}

enum ServiceRequestState {
  captured
  queued
  transmitted
  acknowledged
  in_progress
  completed
  rejected
}

enum OutboxState {
  pending
  processing
  delivered
  dead
}

enum ReminderStatus {
  pending
  sent
  failed
  skipped
}

enum PartnerAppRole {
  inspector
  admin
  order
}

enum RoleGrantKind {
  clinic
  partner_console
  partner_acting
}

enum TrainingMode {
  individual
  group
}

enum OperatingModel {
  provider_operated
  institution_operated
}

// ---------------------------------------------------------------------------
// Tenancy and locations (FA-500..504, NFA-804)
// ---------------------------------------------------------------------------

model Tenant {
  id                  String                   @id @default(cuid())
  name                String
  /** Public tenant identifier (e.g. T-KLN). Unique when set. */
  code                String?                  @unique
  /** Who may suspend the contract (SCH-04/05). */
  operatingModel      OperatingModel           @default(institution_operated)
  /** Legal-entity Organisation with role=institution. Not used by the access gate. */
  institutionOrgId    String?
  institutionOrg      Organisation?            @relation("TenantInstitution", fields: [institutionOrgId], references: [id])
  createdAt           DateTime                 @default(now())
  users               User[]
  sites               Site[]
  areas               Area[]
  siteHeadcounts      SiteHeadcount[]
  safetyOfficerAppointments SafetyOfficerAppointment[]
  instances           DeviceInstance[]
  captured            CapturedArticle[]
  requests            ServiceRequest[]
  orderRequests       OrderRequest[]
  orderItems          OrderItem[]
  statusEvents        StatusEvent[]
  attachments         Attachment[]
  dispatchRecords     DispatchRecord[]
  dispatchTargets     DispatchTarget[]
  externalCalls       ExternalCallLog[]
  oxidConnection      TenantOxidConnection?
  maintenanceEvents   MaintenanceEvent[]
  releaseSnapshots    DeviceReleaseSnapshot[]
  deviceDuties        DeviceDuty[]
  deviceUnitEvents    DeviceUnitEvent[]
  dutyPerformances    DutyPerformance[]
  executorOrgs        ExecutorOrg[]
  serviceContracts    ServiceContract[]
  trainingEvents      TrainingEvent[]
  trainingRecords     TrainingRecord[]
  auditEvents         AuditEvent[]
  attachmentBlobs     AttachmentBlob[]
  reprocessingProfiles DeviceReprocessingProfile[]
  dutyReminders       DutyReminder[]
  dispatchOutbox      DispatchOutbox[]
  deviceClarifications DeviceClarification[]
  deviceEvidence      DeviceEvidence[]
  reprocessingOnDevices ReprocessingOnDevice[]
  userInvitations     UserInvitation[]
  passwordResetTokens PasswordResetToken[]
  smtpSettings        SmtpSettings?

  @@index([institutionOrgId])
}

/// Login identity. Clinic staff belong to one tenant. Partner staff belong to an organisation.
model User {
  id           String   @id @default(cuid())
  /** Set for clinic accounts. Null for partner accounts. */
  tenantId     String?
  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  email        String   @unique
  name         String
  /** Clinic role. Null for partner accounts (role lives on OrgMembership). */
  role         String? // superadmin | device_admin | security_officer | user
  /** clinic | partner — which login door accepts this account. */
  accountKind  String   @default("clinic")
  passwordHash String
  active       Boolean  @default(true)
  jobTitle     String?
  homeAreaId   String?
  homeArea     Area?    @relation("UserHomeArea", fields: [homeAreaId], references: [id])
  employedFrom DateTime? @db.Date
  employedTo   DateTime? @db.Date
  anonymisedAt DateTime?
  /** TOTP MFA — secret stored AES-GCM encrypted (base64 payload). */
  totpEnabled      Boolean   @default(false)
  totpSecretEnc    String?  @db.Text
  totpVerifiedAt   DateTime?
  /** JSON array of scrypt-hashed one-time backup codes. */
  totpBackupHashes String?  @db.Text
  /** Pending enrollment secret (encrypted) until confirm; cleared on enable/cancel. */
  totpPendingEnc   String?  @db.Text
  /** Cookies with iat before this instant are rejected (SEC-03). Null = no revocation yet. */
  sessionsValidFrom    DateTime?
  failedLoginAttempts  Int       @default(0)
  lockedUntil          DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  serviceRequests      ServiceRequest[]
  orderRequests        OrderRequest[]
  oxidConnectionsMade  TenantOxidConnection[] @relation("OxidConnectedBy")
  totpChallenges       TotpChallenge[]
  responsibleDevices   DeviceInstance[]       @relation("DeviceResponsibleUser")
  createdInstances     DeviceInstance[]       @relation("DeviceCreatedBy")
  orgMemberships       OrgMembership[]
  trainingRecords      TrainingRecord[]
  permissions          UserPermission[]
  passwordResetTokens  PasswordResetToken[]

  @@index([tenantId])
  @@index([accountKind])
  @@index([homeAreaId])
}

/** Per-user clinic permission snapshot. Empty set ⇒ fall back to RoleGrant for User.role. */
model UserPermission {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission String
  createdAt  DateTime @default(now())

  @@unique([userId, permission])
  @@index([userId])
}

/// Short-lived login challenge after password OK when TOTP is enabled.
model TotpChallenge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// Exactly one OXID shop link per tenant — configured by admin in Settings.
model TenantOxidConnection {
  id                String    @id @default(cuid())
  tenantId          String    @unique
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  shopBaseUrl       String?
  customerNumber    String?
  companyName       String?
  /** AES-GCM encrypted OAuth access token (same format as TOTP secrets). */
  accessTokenEnc    String?   @db.Text
  /** AES-GCM encrypted OAuth refresh token. */
  refreshTokenEnc   String?   @db.Text
  expiresAt         DateTime?
  status            String    @default("disconnected") // disconnected | connected | error
  lastError         String?   @db.Text
  connectedAt       DateTime?
  connectedByUserId String?
  connectedBy       User?     @relation("OxidConnectedBy", fields: [connectedByUserId], references: [id])
  updatedAt         DateTime  @updatedAt
  createdAt         DateTime  @default(now())
}

model Site {
  id                        String                     @id @default(cuid())
  tenantId                  String
  name                      String
  code                      String? // short site identifier (e.g. BONN-A)
  /** Denormalized display line (street, postal city). */
  address                   String?                    @db.Text
  street                    String?
  postalCode                String?
  city                      String?
  country                   String?                    @default("DE")
  deliveryAddress           String?                    @db.Text
  tenant                    Tenant                     @relation(fields: [tenantId], references: [id])
  areas                     Area[]
  headcounts                SiteHeadcount[]
  safetyOfficerAppointments SafetyOfficerAppointment[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model Area {
  id        String           @id @default(cuid())
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  siteId    String
  name      String
  site      Site             @relation(fields: [siteId], references: [id])
  instances DeviceInstance[]
  homeUsers User[]           @relation("UserHomeArea")

  @@index([siteId])
  @@index([tenantId])
}

model SiteHeadcount {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  siteId     String
  site       Site     @relation(fields: [siteId], references: [id])
  validFrom  DateTime @db.Date
  validTo    DateTime? @db.Date
  headcount  Int
  recordedBy String
  recordedAt DateTime @default(now())

  @@index([siteId])
  @@index([tenantId])
}

model SafetyOfficerAppointment {
  id               String    @id @default(cuid())
  tenantId         String
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  siteId           String
  site             Site      @relation(fields: [siteId], references: [id])
  personName       String
  functionalEmail  String?
  appointedFrom    DateTime  @db.Date
  appointedTo      DateTime? @db.Date
  publishedAt      DateTime? @db.Date
  documentRef      String?

  @@index([siteId])
  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Device master (model) vs. device inventory (instance) — never merged
// ---------------------------------------------------------------------------

model DeviceModel {
  id                     String                     @id @default(cuid())
  basicUdiDi             String?                    @unique
  udiDi                  String?
  gtins                  String?                    @db.Text // JSON string[]
  manufacturer           String?
  manufacturerSrn        String?
  tradeName              String?
  modelName              String?
  riskClass              String?
  emdnCode               String?
  gmdnCode               String?
  productSeries          String?
  source                 String // manual | catalog | beudamed | wizard
  sourceFetchedAt        DateTime?
  version                Int                        @default(1)
  state                  DeviceState                @default(draft)
  maintenanceCycleMonths Int?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  instances              DeviceInstance[]
  externalRecords        ExternalSourceRecord[]
  classifications        DeviceModelClassification[]
  trainingEvents         TrainingEvent[]

  @@index([udiDi])
  @@index([manufacturer, modelName])
}

model ExternalSourceRecord {
  id            String      @id @default(cuid())
  deviceModelId String
  deviceModel   DeviceModel @relation(fields: [deviceModelId], references: [id])
  source        String // "beudamed" | "oxid"
  identifier    String
  payload       String      @db.LongText
  fetchedAt     DateTime

  @@index([source, identifier, fetchedAt])
  @@index([deviceModelId])
}

model DeviceInstance {
  id                     String                   @id @default(cuid())
  tenantId               String
  tenant                 Tenant                   @relation(fields: [tenantId], references: [id])
  inventoryNumber        String
  serialNumber           String?
  udiDi                  String?
  modelId                String?
  model                  DeviceModel?             @relation(fields: [modelId], references: [id])
  areaId                 String?
  area                   Area?                    @relation(fields: [areaId], references: [id])
  room                   String?
  commissionedAt         DateTime?
  responsiblePerson      String?
  responsibleUserId      String?
  responsibleUser        User?                    @relation("DeviceResponsibleUser", fields: [responsibleUserId], references: [id])
  /** draft | review | released | retired */
  state                  DeviceState              @default(draft)
  /** ERF-04 — 1 self / 2 document / 3 third-party; derived from Merkmale on release. */
  releaseLevel           Int?
  productKindCode        String?
  source                 String                   @default("wizard") // wizard | manual | import | scan | external
  legacyMedgvGroup1      Boolean                  @default(false)
  aedExemption           Boolean                  @default(false)
  /** Wizard Merkmale blob before/after freeze (JSON). */
  characteristicsJson    String?                  @db.LongText
  parentInstanceId       String?
  parentInstance         DeviceInstance?          @relation("DeviceAccessory", fields: [parentInstanceId], references: [id])
  childInstances         DeviceInstance[]         @relation("DeviceAccessory")
  retiredAt              DateTime?
  mergedIntoId           String?
  createdByUserId        String?
  createdByUser          User?                    @relation("DeviceCreatedBy", fields: [createdByUserId], references: [id])
  maintenanceCycleMonths Int?
  maintenanceAnchorAt    DateTime?
  lastMaintainedAt       DateTime?
  nextMaintenanceDueAt   DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  maintenanceEvents      MaintenanceEvent[]
  releaseSnapshots       DeviceReleaseSnapshot[]
  duties                 DeviceDuty[]
  referencingDuties      DeviceDuty[]             @relation("DutyReference")
  unitEvents             DeviceUnitEvent[]
  reprocessingProfile    DeviceReprocessingProfile?
  clarifications         DeviceClarification[]
  evidence               DeviceEvidence[]
  reprocessedOn          ReprocessingOnDevice[]   @relation("ReprocessedItem")
  usedForReprocessing    ReprocessingOnDevice[]   @relation("ReprocessingEquipment")

  @@unique([tenantId, inventoryNumber])
  /** SCH-01 — same serial under the same model is rejected (NULLs allowed). */
  @@unique([tenantId, modelId, serialNumber])
  @@index([tenantId, serialNumber])
  @@index([tenantId, nextMaintenanceDueAt])
  @@index([tenantId, state])
  @@index([responsibleUserId])
}

model MaintenanceEvent {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  deviceInstanceId String
  deviceInstance   DeviceInstance @relation(fields: [deviceInstanceId], references: [id])
  kind             String
  performedAt      DateTime
  previousDueAt    DateTime?
  nextDueAt        DateTime?
  cycleMonths      Int?
  note             String?        @db.Text
  actorUserId      String?
  createdAt        DateTime       @default(now())

  @@index([tenantId, deviceInstanceId, performedAt])
  @@index([tenantId, performedAt])
}

model CapturedArticle {
  id                    String   @id @default(cuid())
  tenantId              String
  tenant                Tenant   @relation(fields: [tenantId], references: [id])
  name                  String
  manufacturer          String?
  number                String?
  numberType            String // gtin | pzn | manufacturer | none
  rawIdentifier         String?
  nameplateAttachmentId String?
  capturedBy            String?
  capturedAt            DateTime @default(now())
  serviceOnly           Boolean  @default(true)

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Regulatory reference data (cross-tenant, seeded)
// ---------------------------------------------------------------------------

model RefRuleSet {
  id              String                        @id
  code            String
  title           String
  legalBasis      String
  versionLabel    String
  validFrom       DateTime                      @db.Date
  validTo         DateTime?                     @db.Date
  sourceNote      String?                       @db.Text
  inspectionTypes RefInspectionType[]
  annex2Items     RefAnnex2Item[]
  reprocClasses   RefReprocessingClass[]
  reprocEquipment RefReprocessingEquipmentType[]
  radiationApps   RefRadiationApplication[]
  constancyObjects RefConstancyObject[]
  trainingTypes   RefTrainingType[]
  classifications DeviceModelClassification[]
  commissioningPrerequisites RefCommissioningPrerequisite[]

  @@unique([code, versionLabel])
}

model RefInspectionType {
  code             String         @id
  ruleSetId        String
  ruleSet          RefRuleSet     @relation(fields: [ruleSetId], references: [id])
  label            String
  legalBasis       String
  deadlineAnchor   DeadlineAnchor
  defaultInterval  Int?
  intervalUnit     String? // months | years
  evidenceHint     String?        @db.Text
  category         DutyCategory   @default(inspection)
  confidence       Confidence     @default(derived)
  sourceRef        String?
  duties           DeviceDuty[]
}

model RefAnnex2Item {
  id               String     @id
  ruleSetId        String
  ruleSet          RefRuleSet @relation(fields: [ruleSetId], references: [id])
  itemNo           String
  parentItemNo     String?
  label            String     @db.Text
  restriction      String?    @db.Text
  isGroup          Boolean    @default(false)
  intervalYears    Int?
  conditionText    String?    @db.Text
  matchTerms       Json
  matchExclude     Json
  matchConfidence  String     @default("derived")
  reviewFlag       String?
  confidence       Confidence @default(derived)
  sourceRef        String?
  classifications  DeviceModelClassification[]

  @@index([ruleSetId, itemNo])
}

model RefProductKind {
  code      String @id
  label     String
  hint      String?
  sortGroup String
  shows     Json   // string[]
  blocks    Json   // string[]
  presets   Json   // object
}

model RefReprocessingClass {
  code                     String  @id
  ruleSetId                String
  ruleSet                  RefRuleSet @relation(fields: [ruleSetId], references: [id])
  label                    String
  requiresQmsCert          Boolean @default(false)
  /** AUF-01 — false for unkritisch (intact skin only). */
  requiresValidatedProcess Boolean @default(true)
  evidence                 String? @db.Text
  note                     String? @db.Text
  profiles                 DeviceReprocessingProfile[]
}

model RefReprocessingEquipmentType {
  code                String @id
  ruleSetId           String
  ruleSet             RefRuleSet @relation(fields: [ruleSetId], references: [id])
  label               String
  equipmentStandard   String
  validationStandard  String
  revalidationMonths  Int
  intervalDisputed    Boolean @default(false)
  intervalSource      String  @db.Text
  routineChecks       String  @db.Text // JSON string[]
  releaseRule         String? @db.Text
}

model RefRadiationApplication {
  code                   String  @id
  ruleSetId              String
  ruleSet                RefRuleSet @relation(fields: [ruleSetId], references: [id])
  label                  String
  defaultAuthorisation   String // notification | licence
  medicalBoardNote       String? @db.Text
  qualityGuideline       String?
  expertInspectionApplies Boolean @default(true)
}

model RefConstancyObject {
  code            String @id
  ruleSetId       String
  ruleSet         RefRuleSet @relation(fields: [ruleSetId], references: [id])
  label           String
  defaultCadence  String
  duties          DeviceDuty[]
}

model RefTrainingType {
  code            String @id
  ruleSetId       String
  ruleSet         RefRuleSet @relation(fields: [ruleSetId], references: [id])
  label           String
  legalBasis      String
  subjectKind     String // model | activity
  validityMonths  Int?
  chainAllowed    Boolean @default(false)
  note            String? @db.Text
  trainingEvents  TrainingEvent[]
}

/** C2 — versioned commissioning checklist (was hard-coded in prerequisites.ts). */
model RefCommissioningPrerequisite {
  id           String       @id @default(cuid())
  ruleSetId    String
  ruleSet      RefRuleSet   @relation(fields: [ruleSetId], references: [id])
  code         String
  label        String
  legalBasis   String
  note         String?      @db.Text
  mandatory    Boolean      @default(true)
  evidenceKind EvidenceKind @default(confirmation)
  /** Expression over Merkmale (JSON-ish / simple keys); evaluated in app. */
  appliesWhen  String       @db.Text
  releaseLevel Int          @default(1)

  @@unique([ruleSetId, code])
  @@index([ruleSetId])
}

// ---------------------------------------------------------------------------
// Model classification (historised) + release freeze
// ---------------------------------------------------------------------------

model DeviceModelClassification {
  id             String       @id @default(cuid())
  deviceModelId  String
  deviceModel    DeviceModel  @relation(fields: [deviceModelId], references: [id])
  validFrom      DateTime     @default(now())
  validTo        DateTime?
  stk            Boolean      @default(false)
  mtkItemId      String?
  mtkItem        RefAnnex2Item? @relation(fields: [mtkItemId], references: [id])
  radiation      Boolean      @default(false)
  softwareClass  String?
  confidence     Confidence   @default(derived)
  evidenceText   String?      @db.Text
  ruleSetId      String
  ruleSet        RefRuleSet   @relation(fields: [ruleSetId], references: [id])
  confirmedBy    String?
  confirmedAt    DateTime?
  /** C4 — product kind + model-owned Merkmale for reuse across instances. */
  productKindCode String?
  characteristics String?     @db.LongText // JSON
  fieldStates     String?     @db.LongText // JSON: field → FieldState
  decisions       String?     @db.LongText // JSON: field → { value, proposal, by, at }
  deferredFields  String?     @db.Text // JSON string[]
  /**
   * SCH-02 — set to deviceModelId while validTo is null; cleared when closed.
   * Unique so only one open classification per model.
   */
  openClassificationKey String? @unique @db.VarChar(191)
  snapshots      DeviceReleaseSnapshot[]

  @@index([deviceModelId])
  @@index([deviceModelId, validTo])
}

model DeviceReleaseSnapshot {
  id               String                    @id @default(cuid())
  tenantId         String
  tenant           Tenant                    @relation(fields: [tenantId], references: [id])
  deviceInstanceId String
  deviceInstance   DeviceInstance            @relation(fields: [deviceInstanceId], references: [id])
  releasedAt       DateTime                  @default(now())
  releasedBy       String
  ruleSetIds       String                    @db.Text // JSON string[]
  classificationId String?
  classification   DeviceModelClassification? @relation(fields: [classificationId], references: [id])
  characteristics  String                    @db.LongText // JSON
  derivedDuties    String                    @db.LongText // JSON
  prerequisites    String                    @db.LongText // JSON
  appVersion       String
  duties           DeviceDuty[]

  @@index([deviceInstanceId, releasedAt])
  @@index([tenantId])
}

model DeviceDuty {
  id                  String                 @id @default(cuid())
  tenantId            String
  tenant              Tenant                 @relation(fields: [tenantId], references: [id])
  deviceInstanceId    String
  deviceInstance      DeviceInstance         @relation(fields: [deviceInstanceId], references: [id])
  snapshotId          String
  snapshot            DeviceReleaseSnapshot  @relation(fields: [snapshotId], references: [id])
  dutyKey             String // wartung | stk | mtk | …
  inspectionTypeCode  String
  inspectionType      RefInspectionType      @relation(fields: [inspectionTypeCode], references: [code])
  deadlineAnchor      DeadlineAnchor
  intervalValue       Int?
  intervalUnit        String?
  cadenceLabel        String?
  constancyObjectCode String?
  constancyObject     RefConstancyObject?    @relation(fields: [constancyObjectCode], references: [code])
  basisText           String                 @db.Text
  confidence          Confidence
  applicable          Boolean                @default(true)
  notApplicableReason String?                @db.Text
  referenceDate       DateTime               @db.Date
  /** Computed from referenceDate + interval + deadlineAnchor; null for event/process/permanent. */
  dueAt               DateTime?              @db.Date
  lastCompletedAt     DateTime?
  lastNotifiedAt      DateTime?
  /** Reminder stage last sent (T-90 | T-30 | T-7 | due | overdue). */
  notifyStage         String?
  suspendedAt         DateTime?
  title               String?
  evidenceHint        String?                @db.Text
  category            DutyCategory           @default(inspection)
  setsBaseline        Boolean                @default(false)
  requiresBaseline    Boolean                @default(false)
  /** AUF-01 — product duty that references equipment instance. */
  referenceDeviceId   String?
  referenceDevice     DeviceInstance?        @relation("DutyReference", fields: [referenceDeviceId], references: [id])
  serviceRequests     ServiceRequest[]
  performances        DutyPerformance[]
  reminders           DutyReminder[]

  @@index([deviceInstanceId])
  @@index([tenantId])
  @@index([snapshotId])
  @@index([tenantId, suspendedAt, dueAt])
  @@index([referenceDeviceId])
}

/** FA-715 — completion history that rolls the next due date. */
model DutyPerformance {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  deviceDutyId     String
  deviceDuty       DeviceDuty     @relation(fields: [deviceDutyId], references: [id])
  serviceRequestId String?
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id])
  performedAt      DateTime       @db.Date
  result           String         @default("passed") // passed | passed_with_conditions | failed
  note             String?        @db.Text
  performedBy      String
  source           String         @default("assignment") // assignment | manual | import
  recordedAt       DateTime       @default(now())

  @@index([deviceDutyId, performedAt])
  @@index([tenantId])
  @@index([serviceRequestId])
}

/// Legal entity once. Capacity lives on OrganisationRole — not inferred from the table.
model Organisation {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  contact     String?
  /** MySQL DATE cannot default to CURRENT_TIMESTAMP — set in app/seed. */
  activeFrom  DateTime @db.Date
  activeTo    DateTime? @db.Date
  memberships OrgMembership[]
  contracts   ServiceContract[]
  roles       OrganisationRole[]
  invitations UserInvitation[]
  institutionTenants Tenant[] @relation("TenantInstitution")
  smtpSettings SmtpSettings?

  @@index([activeTo])
}

/** Outbound SMTP for a clinic tenant or partner organisation (exactly one owner). */
model SmtpSettings {
  id              String        @id @default(cuid())
  tenantId        String?       @unique
  tenant          Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organisationId  String?       @unique
  organisation    Organisation? @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  host            String
  port            Int           @default(587)
  secure          Boolean       @default(false)
  user            String
  passEnc         String        @db.Text
  fromAddr        String
  updatedAt       DateTime      @updatedAt
  updatedByUserId String?

  @@index([organisationId])
}

/// Capacity of an organisation: institution | service_provider | inspection_partner | platform_operator.
model OrganisationRole {
  id             String       @id @default(cuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  /** institution | service_provider | inspection_partner | platform_operator */
  role           String
  grantedFrom    DateTime     @db.Date
  grantedTo      DateTime?    @db.Date

  @@unique([organisationId, role])
  @@index([role, grantedTo])
}

/// A partner user at one organisation. Clinic users do not get a row here.
model OrgMembership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  /** inspector | admin | order */
  appRole        PartnerAppRole
  /** MySQL DATE cannot default to CURRENT_TIMESTAMP — set in app/seed. */
  validFrom      DateTime     @db.Date
  validTo        DateTime?    @db.Date

  @@unique([organisationId, userId])
  @@index([userId])
}

/// Live link that lets a service_provider organisation open one clinic.
model ServiceContract {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  validFrom      DateTime     @db.Date
  validTo        DateTime?    @db.Date
  terminatedAt   DateTime?
  suspendedAt    DateTime?
  billingRef     String?
  /** JSON string[] — inventory | due-dates | inspection */
  scope          String       @db.Text

  @@unique([tenantId, organisationId])
  @@index([organisationId])
}

/// Schulungstermin — one event, many individual training_record proofs.
model TrainingEvent {
  id                       String   @id @default(cuid())
  tenantId                 String
  tenant                   Tenant   @relation(fields: [tenantId], references: [id])
  trainingTypeCode         String
  trainingType             RefTrainingType @relation(fields: [trainingTypeCode], references: [code])
  /** Exactly one of subjectModelId | subjectActivity (enforced in app). */
  subjectModelId           String?
  subjectModel             DeviceModel? @relation(fields: [subjectModelId], references: [id])
  subjectActivity          String?
  heldOn                   DateTime @db.Date
  location                 String?
  instructorName           String
  instructorQualification  String
  instructorExternal       Boolean  @default(false)
  basisDocument            String
  /** individual | group */
  mode                     TrainingMode
  recordedBy               String
  recordedAt               DateTime @default(now())
  records                  TrainingRecord[]

  @@index([tenantId, heldOn])
  @@index([trainingTypeCode])
  @@index([subjectModelId])
}

/// Einzelnachweis je clinic staff User (ops.person mapped onto User).
model TrainingRecord {
  id          String        @id @default(cuid())
  tenantId    String
  tenant      Tenant        @relation(fields: [tenantId], references: [id])
  eventId     String
  event       TrainingEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /** Clinic staff subject — accountKind=clinic, tenant-scoped. Never a partner User. */
  personId    String
  person      User          @relation(fields: [personId], references: [id])
  confirmedAt DateTime      @default(now())
  validUntil  DateTime?     @db.Date

  @@unique([eventId, personId])
  @@index([tenantId])
  @@index([personId, validUntil])
}

/** FA-713 — in-house executor still stored per clinic. External partners use Organisation. */
model ExecutorOrg {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  code      String // O-MSR | O-RTS | O-INT
  name      String
  kind      String // external | internal
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  requests  ServiceRequest[]
  dispatchTargets DispatchTarget[]

  @@unique([tenantId, code])
  @@index([tenantId])
}

model DeviceUnitEvent {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  deviceInstanceId String
  deviceInstance   DeviceInstance @relation(fields: [deviceInstanceId], references: [id])
  occurredAt       DateTime       @default(now())
  actor            String
  action           String
  fromState        String?
  toState          String?
  note             String?        @db.Text

  @@index([deviceInstanceId, occurredAt])
  @@index([tenantId])
}

model DeviceReprocessingProfile {
  deviceInstanceId String                 @id
  deviceInstance   DeviceInstance         @relation(fields: [deviceInstanceId], references: [id])
  tenantId         String
  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  classCode        String
  reprocessingClass RefReprocessingClass  @relation(fields: [classCode], references: [code])
  outsourced       Boolean                @default(false)
  contractor       String?
  assessedBy       String
  assessedAt       DateTime               @default(now())

  @@index([tenantId])
}

// ---------------------------------------------------------------------------
// Service requests (FA-600..602, SS-701..703)
// ---------------------------------------------------------------------------

model ServiceRequest {
  id              String              @id @default(cuid())
  reference       String              @unique
  idempotencyKey  String              @unique
  fingerprint     String
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  subjectType     String // instance | model | captured
  subjectId       String
  serviceType     String
  priority        String?
  note            String?             @db.Text
  raisedBy        String?
  raisedById      String?
  raisedByUser    User?               @relation(fields: [raisedById], references: [id])
  siteId          String?
  locationText    String              @db.Text
  accessHint      String?             @db.Text
  contact         String?
  deliveryAddress String              @db.Text
  /** Optional legacy JSON; no longer driven by a proposal engine. */
  classification  String?             @db.Text
  correlationId   String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  state           ServiceRequestState @default(captured)
  /** FA-710 — due_date | app */
  source          String              @default("app")
  /** When created from a Fälligkeit (FA-702). */
  dutyId          String?
  duty            DeviceDuty?         @relation(fields: [dutyId], references: [id])
  /** FA-713 — allocated executor organisation. */
  executorOrgId   String?
  executorOrg     ExecutorOrg?        @relation(fields: [executorOrgId], references: [id])
  allocatedAt     DateTime?
  allocatedBy     String?
  /** FA-714 — set on transmit; allocation becomes immutable. */
  transmittedAt   DateTime?
  statusEvents    StatusEvent[]
  attachments     Attachment[]
  dispatchRecords DispatchRecord[]
  performances    DutyPerformance[]
  dispatchOutbox  DispatchOutbox[]

  @@index([tenantId, createdAt])
  @@index([raisedById])
  @@index([dutyId])
  @@index([executorOrgId])
  @@index([tenantId, source, state])
}

model StatusEvent {
  id               String              @id @default(cuid())
  tenantId         String
  tenant           Tenant              @relation(fields: [tenantId], references: [id])
  serviceRequestId String
  serviceRequest   ServiceRequest      @relation(fields: [serviceRequestId], references: [id])
  state            ServiceRequestState
  changedAt        DateTime            @default(now())
  source           String
  actor            String?
  note             String?             @db.Text

  @@index([serviceRequestId, changedAt])
  @@index([tenantId])
}

model Attachment {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  kind             String
  url              String         @db.Text
  createdAt        DateTime       @default(now())

  @@index([serviceRequestId])
  @@index([tenantId])
}

model AttachmentBlob {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  kind        String
  dataUrl     String   @db.LongText
  contentType String?
  byteSize    Int?
  createdAt   DateTime @default(now())
  evidence    DeviceEvidence[]

  @@index([tenantId])
}

model DispatchTarget {
  id            String       @id @default(cuid())
  tenantId      String
  tenant        Tenant       @relation(fields: [tenantId], references: [id])
  /** Owning executor — each org has its own mail / API endpoints. */
  executorOrgId String?
  executorOrg   ExecutorOrg? @relation(fields: [executorOrgId], references: [id])
  type          String
  name          String
  endpoint      String?      @db.Text
  auth          String?      @db.Text
  mapping       String?      @db.Text
  enabled       Boolean      @default(true)
  retryPolicy   String?      @db.Text

  dispatchRecords DispatchRecord[]
  outboxEntries   DispatchOutbox[]

  @@index([tenantId, enabled])
  @@index([executorOrgId, enabled])
}

model DispatchRecord {
  id               String          @id @default(cuid())
  tenantId         String
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  serviceRequestId String
  serviceRequest   ServiceRequest  @relation(fields: [serviceRequestId], references: [id])
  targetId         String?
  targetRef        DispatchTarget? @relation(fields: [targetId], references: [id])
  target           String
  timestamp        DateTime        @default(now())
  success          Boolean         @default(false)
  httpStatus       Int?
  response         String?         @db.Text
  error            String?         @db.Text
  attemptCount     Int             @default(1)
  correlationId    String?

  @@index([serviceRequestId])
  @@index([tenantId])
}

model OrderRequest {
  id              String      @id @default(cuid())
  reference       String      @unique
  idempotencyKey  String      @unique
  fingerprint     String
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id])
  raisedBy        String?
  raisedById      String?
  raisedByUser    User?       @relation(fields: [raisedById], references: [id])
  subjectType     String?
  subjectId       String?
  deliveryAddress String      @db.Text
  note            String?     @db.Text
  approvalState   String      @default("pending_approval")
  state           String      @default("captured")
  correlationId   String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]

  @@index([tenantId, createdAt])
  @@index([raisedById])
}

model OrderItem {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id])
  orderRequestId String
  orderRequest   OrderRequest @relation(fields: [orderRequestId], references: [id])
  articleId      String?
  articleNumber  String
  description    String
  quantity       Int
  unitPrice      Float?

  @@index([orderRequestId])
  @@index([tenantId])
}

model ExternalCallLog {
  id             String   @id @default(cuid())
  tenantId       String?
  tenant         Tenant?  @relation(fields: [tenantId], references: [id])
  system         String
  operation      String
  identifierHash String
  correlationId  String?
  startedAt      DateTime @default(now())
  durationMs     Int
  cacheHit       Boolean  @default(false)
  success        Boolean
  httpStatus     Int?
  error          String?  @db.Text

  @@index([system, identifierHash, startedAt])
  @@index([tenantId, startedAt])
}

model RoleGrant {
  id         String        @id @default(cuid())
  /** clinic | partner_console | partner_acting — isolates clinic /roles from partner grants. */
  kind       RoleGrantKind @default(clinic)
  role       String
  permission String
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([kind, role, permission])
  @@index([kind, role])
}

/// Append-only product audit. Actor fields are snapshots — do not join User later.
model AuditEvent {
  id                String   @id @default(cuid())
  occurredAt        DateTime @default(now())
  tenantId          String?
  tenant            Tenant?  @relation(fields: [tenantId], references: [id])
  actorUserId       String?
  actorKind         String // clinic | partner | platform | system
  actorRole         String?
  actorName         String
  organisationId    String?
  organisationName  String?
  serviceContractId String?
  correlationId     String?
  ip                String?
  userAgent         String?  @db.Text
  resource          String
  resourceId        String
  action            String
  summary           String   @db.Text
  before            String?  @db.LongText // JSON changed fields
  after             String?  @db.LongText // JSON changed fields

  @@index([tenantId, occurredAt])
  @@index([tenantId, resource, resourceId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([organisationId, occurredAt])
  @@index([correlationId])
}

/** OPS-01 — one row per duty × reminder stage; delivery status for the deadline run. */
model DutyReminder {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  deviceDutyId String
  deviceDuty   DeviceDuty @relation(fields: [deviceDutyId], references: [id])
  /** T-90 | T-30 | T-7 | due | overdue */
  stage        String
  scheduledFor DateTime   @db.Date
  /** pending | sent | failed | skipped */
  status       ReminderStatus @default(pending)
  attemptCount Int        @default(0)
  lastError    String?    @db.Text
  sentAt       DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([deviceDutyId, stage])
  @@index([tenantId, status, scheduledFor])
  @@index([tenantId, deviceDutyId])
}

/** OPS-02 — durable retry queue for failed dispatch attempts. DispatchRecord remains the log. */
model DispatchOutbox {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id])
  targetId         String
  target           DispatchTarget @relation(fields: [targetId], references: [id])
  /** pending | processing | delivered | dead */
  state            OutboxState    @default(pending)
  attemptCount     Int            @default(0)
  nextAttemptAt    DateTime       @default(now())
  lastError        String?        @db.Text
  correlationId    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([serviceRequestId, targetId])
  @@index([tenantId, state, nextAttemptAt])
  @@index([nextAttemptAt, state])
}

// ---------------------------------------------------------------------------
// C — Erstanlage clarifications, evidence, reprocessing links
// ---------------------------------------------------------------------------

model DeviceClarification {
  id               String         @id @default(cuid())
  tenantId         String
  tenant           Tenant         @relation(fields: [tenantId], references: [id])
  deviceInstanceId String
  deviceInstance   DeviceInstance @relation(fields: [deviceInstanceId], references: [id])
  /** classification | evidence | duplicate | mandatory_field */
  kind             String
  field            String?
  prerequisiteCode String?
  label            String
  deferredBy       String
  deferredAt       DateTime
  resolvedBy       String?
  resolvedAt       DateTime?
  resolutionNote   String?        @db.Text

  @@index([tenantId, deviceInstanceId])
  @@index([tenantId, resolvedAt])
}

model DeviceEvidence {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  deviceInstanceId  String
  deviceInstance    DeviceInstance @relation(fields: [deviceInstanceId], references: [id])
  prerequisiteCode  String
  evidenceKind      EvidenceKind
  attachmentBlobId  String?
  attachmentBlob    AttachmentBlob? @relation(fields: [attachmentBlobId], references: [id])
  externalRecordRef String?
  issuedBy          String?
  issuedAt          DateTime?
  validUntil        DateTime?
  recordedBy        String
  recordedAt        DateTime       @default(now())

  @@unique([deviceInstanceId, prerequisiteCode])
  @@index([tenantId, validUntil])
  @@index([attachmentBlobId])
}

model ReprocessingOnDevice {
  id                String         @id @default(cuid())
  tenantId          String
  tenant            Tenant         @relation(fields: [tenantId], references: [id])
  profileDeviceId   String
  equipmentDeviceId String
  profileDevice     DeviceInstance @relation("ReprocessedItem", fields: [profileDeviceId], references: [id])
  equipmentDevice   DeviceInstance @relation("ReprocessingEquipment", fields: [equipmentDeviceId], references: [id])
  recordedBy        String
  recordedAt        DateTime       @default(now())

  @@unique([profileDeviceId, equipmentDeviceId])
  @@index([tenantId, equipmentDeviceId])
}

/** SEC-07 — admin-triggered password reset; redeem sets a new password via email link. */
model PasswordResetToken {
  id              String    @id @default(cuid())
  tenantId        String
  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String    @unique
  expiresAt       DateTime
  redeemedAt      DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())

  @@index([tenantId, userId])
  @@index([expiresAt])
}

/** SEC-07 — invite user; redeem sets password. Clinic: tenantId set; partner: organisationId set. */
model UserInvitation {
  id               String        @id @default(cuid())
  tenantId         String?
  tenant           Tenant?       @relation(fields: [tenantId], references: [id])
  organisationId   String?
  organisation     Organisation? @relation(fields: [organisationId], references: [id])
  email            String
  name             String?
  /** Clinic role when tenant invite. */
  role             String?
  /** Partner app role when org invite. */
  appRole          PartnerAppRole?
  /** Optional full permission snapshot; null ⇒ redeem uses role RoleGrant preset only. */
  permissions      Json?
  tokenHash        String        @unique
  expiresAt        DateTime
  acceptedAt       DateTime?
  createdByUserId  String?
  createdAt        DateTime      @default(now())

  @@index([tenantId, email])
  @@index([organisationId, email])
  @@index([expiresAt])
}
