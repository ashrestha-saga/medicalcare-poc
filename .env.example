# ---------------------------------------------------------------------------
# Database (MySQL)
# ---------------------------------------------------------------------------
# URL-encode special characters in the password (e.g. / → %2F, @ → %40).
DATABASE_URL="mysql://user:password@127.0.0.1:3306/devicecare"
# Optional isolated DB for Vitest (avoids wiping the app DB on npm test).
# TEST_DATABASE_URL="mysql://user:password@127.0.0.1:3306/devicecare_test"

# ---------------------------------------------------------------------------
# OXID — OAuth2 + PKCE (Merzljak API Module v1.5+)
# ---------------------------------------------------------------------------
# Example shop URLs (replace host):
#   OXID_AUTHORIZE_URL="https://your-shop.com/index.php?cl=oauthauthorize"
#   OXID_TOKEN_URL="https://your-shop.com/index.php?cl=oauthtoken&fnc=token"
#   OXID_API_BASE_URL="https://your-shop.com/index.php"
OXID_CLIENT_ID=
OXID_CLIENT_SECRET=
OXID_AUTHORIZE_URL=
OXID_TOKEN_URL=
OXID_API_BASE_URL=
OXID_REDIRECT_URI="http://localhost:3000/auth/callback"
OXID_SCOPE="profile address api"
# "mock" uses in-repo fixtures; "http" calls getArticles (oxean) for catalog stage 2.
OXID_ADAPTER_MODE="mock"

# ---------------------------------------------------------------------------
# BEUDAMED — OpenAPI https://beudamed.com/api (Bearer token)
# ---------------------------------------------------------------------------
BEUDAMED_API_BASE_URL="https://beudamed.com/api/v1"
BEUDAMED_API_KEY=
BEUDAMED_CACHE_TTL_DAYS=90
BEUDAMED_TIMEOUT_MS=8000
BEUDAMED_RATE_LIMIT_PER_IDENTIFIER_PER_HOUR=1
BEUDAMED_RATE_LIMIT_PER_TENANT_PER_DAY=200
# "stub" never makes a network call (stage 3 always misses); "mock" answers from
# an in-repo fixture; "http" calls GET /eudamed_devices/{id} then /fda_udis/{id}.
BEUDAMED_ADAPTER_MODE="stub"

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used to sign the httpOnly session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=
# Optional separate key for encrypting TOTP secrets (defaults to SESSION_SECRET).
# Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER="DeviceCare"
